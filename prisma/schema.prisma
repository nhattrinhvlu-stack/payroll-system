generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. CÁC DANH SÁCH CỐ ĐỊNH (ENUM) ---

enum Role {
  DIRECTOR
  ACCOUNTANT
  WAREHOUSE
  EMPLOYEE
}

enum PayrollStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL    // Nghỉ phép năm
  SICK      // Nghỉ bệnh
  UNPAID    // Nghỉ không lương
  OTHER     // Khác
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveSession {
  ALL_DAY     // Cả ngày
  MORNING     // Buổi sáng
  AFTERNOON   // Buổi chiều
}

enum ContractType {
  FULL_TIME   // Toàn thời gian
  PART_TIME   // Bán thời gian
  CONTRACT    // Hợp đồng thời vụ
  PROBATION   // Thử việc
}

enum SalaryType {
  MONTHLY   // Lương tháng
  DAILY     // Lương ngày (cuối ngày nhận)
}

// --- 2. QUẢN LÝ PHÒNG BAN ---
model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// --- 3. QUẢN LÝ NHÂN SỰ ---
model Employee {
  id          String    @id @default(cuid())

  // Login
  username    String    @unique
  password    String
  role        Role      @default(EMPLOYEE)

  // Info
  fullName    String
  email       String?   @unique
  phone       String?
  dob         DateTime?

  // Lương & Phụ cấp Cá nhân (MỚI)
  salaryType           SalaryType @default(MONTHLY)
  dailyWage            Float   @default(0)   // Tiền/ngày, dùng khi salaryType = DAILY
  baseSalary           Float
  responsibilityAmount Float   @default(0)
  phoneAllowance       Float   @default(0)
  otherAllowance       Float   @default(0)
  hasInsurance         Boolean @default(false)

  // Quan hệ
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  isActive    Boolean   @default(true)

  payrolls             Payroll[]
  attendances          Attendance[]
  leaveRequests        LeaveRequest[]
  contracts            Contract[]
  materialTransactions MaterialTransaction[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// --- 4. CÀI ĐẶT CỦA GIÁM ĐỐC (SETTINGS) ---
model GlobalSettings {
  id                    String   @id @default("default")

  standardWorkDays      Int      @default(26)
  overtimeRatio         Float    @default(1.5)
  fuelPricePerKm        Float    @default(5000)   // legacy, không dùng trong tính toán nữa
  insurancePercent      Float    @default(0)

  // Đơn giá xăng theo bán kính
  fuelPrice1to15        Float    @default(3000)   // 1–15 km
  fuelPrice20to30       Float    @default(4000)   // 20–30 km
  fuelPriceAbove30      Float    @default(5000)   // trên 30 km

  updatedAt             DateTime @updatedAt
}

// --- 5. CHẤM CÔNG ---
model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])

  date        DateTime
  workingDays Float    @default(1)
  overtime    Float    @default(0)
  kmTraveled  Float    @default(0)

  dailyAllowance Float    @default(0)
  dailyAdvance   Float    @default(0)

  // Theo dõi trả lương ngày
  isPaid      Boolean  @default(false)
  paidAt      DateTime?

  note        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
}

// --- 6. BẢNG LƯƠNG ---
model Payroll {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])

  month         Int
  year          Int

  baseSalary    Float
  standardDays  Int      @default(26)
  actualWorkDays Float   @default(0)

  overtimeHours Float    @default(0)
  overtimeSalary Float   @default(0)

  kmTraveled    Float    @default(0)
  fuelAllowance Float    @default(0)

  responsibility Float   @default(0)
  phoneAllowance Float   @default(0)
  otherAllowance Float   @default(0)

  advancePayment Float   @default(0)
  insurance      Float   @default(0)

  totalSalary    Float

  status          PayrollStatus @default(DRAFT)
  rejectionReason String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, month, year])
}

// --- 7. ĐƠN XIN NGHỈ PHÉP ---
model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])

  type         LeaveType
  session      LeaveSession @default(ALL_DAY) // MỚI THÊM: Sáng/Chiều/Cả ngày
  startDate    DateTime
  endDate      DateTime
  totalDays    Float
  reason       String

  status       LeaveStatus @default(PENDING)
  approverNote String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// --- 8. HỢP ĐỒNG LAO ĐỘNG ---
model Contract {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id])

  type       ContractType
  startDate  DateTime
  endDate    DateTime?
  note       String?
  isActive   Boolean      @default(true)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// --- 9. LỊCH SỬ THAY ĐỔI (AUDIT LOG) ---
model AuditLog {
  id        String   @id @default(cuid())
  actorName String
  action    String
  target    String
  detail    String?

  createdAt DateTime @default(now())
}

// --- QUẢN LÝ VẬT TƯ ---

enum TransactionType {
  IMPORT   // Nhập vật tư từ nhà cung cấp
  EXPORT   // Xuất cấp phát cho bộ phận/nhân viên
  ADJUST   // Điều chỉnh tồn kho (chỉ DIRECTOR)
  RETURN   // Nhân viên trả lại kho
}

enum TransactionStatus {
  CONFIRMED
  CANCELLED
}

// --- 10. DANH MỤC LOẠI VẬT TƯ ---
model MaterialCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  materials   Material[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// --- 11. NHÀ CUNG CẤP ---
model Supplier {
  id           String               @id @default(cuid())
  name         String
  phone        String?
  address      String?
  contactName  String?
  note         String?
  isActive     Boolean              @default(true)
  transactions MaterialTransaction[]

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// --- 12. DANH MỤC VẬT TƯ (MASTER DATA) ---
model Material {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  unit          String
  description   String?
  minStockLevel Float                @default(0)
  currentStock  Float                @default(0)
  unitPrice     Float                @default(0)
  isActive      Boolean              @default(true)

  categoryId    String?
  category      MaterialCategory?    @relation(fields: [categoryId], references: [id])

  transactions  MaterialTransaction[]

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// --- 13. NHẬT KÝ GIAO DỊCH VẬT TƯ ---
model MaterialTransaction {
  id              String            @id @default(cuid())
  materialId      String
  material        Material          @relation(fields: [materialId], references: [id])

  type            TransactionType
  status          TransactionStatus @default(CONFIRMED)

  quantity        Float
  unitPrice       Float             @default(0)
  stockBefore     Float
  stockAfter      Float

  transactionDate DateTime          @default(now())
  reference       String?
  reason          String?
  note            String?

  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])

  receivedById    String?
  receivedBy      Employee?         @relation(fields: [receivedById], references: [id])

  createdByName   String

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}
